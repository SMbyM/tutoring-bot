# debug — тестовый режим: админы и репетиторы могут переключать роли и «проматывать» уроки.
# production — всё тестовое отключено.
APP_ENV=debug

# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_TG_IDS=

# Закрытый канал с материалами (ID вида -100…). Бот — админ канала с правом приглашать и блокировать.
# Пусто — выдача доступа выключена.
CHANNEL_ID=

# Публичный HTTPS-адрес, по которому снаружи доступен порт 8080 (для Mini App репетитора).
# Пусто — кнопка редактора не показывается, окна задаются текстом.
MINIAPP_URL=

# Ссылка на политику обработки персональных данных (показывается при регистрации)
POLICY_URL=

# Доступ к Telegram из РФ: либо свой адрес Bot API (через туннель),
# либо стандартный HTTPS-прокси (HTTPS_PROXY=http://host:port) — Go подхватывает его сам.
TELEGRAM_API_URL=
HTTPS_PROXY=

# Через сколько дней без занятий ученика исключают из канала
ACCESS_INACTIVITY_DAYS=30
# На сколько дней вперёд показывать свободные окна
BOOKING_HORIZON_DAYS=14
# На сколько дней вперёд создавать уроки постоянного времени
RECURRING_AHEAD_DAYS=28

POSTGRES_PASSWORD=change-me
